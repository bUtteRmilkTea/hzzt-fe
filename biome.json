{
  "files": {
    "includes": [
      "**",
      "!dist",
      "!plan",
      "!public",
      "!.claude",
      "!node_modules",
      "!coverage",
      "!playwright-report",
      "!test-results",
      "!pnpm-lock.yaml",
      "!src/shared/api/schema.d.ts",
      "!src/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "parseFloat": "Never parse money with parseFloat. Use shared/money (decimal.js-light)."
            }
          }
        }
      }
    }
  },
  "plugins": ["./.biome/no-raw-hex.grit"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
