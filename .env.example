# Copy to .env (gitignored). Never commit real values.

# API prefix the browser calls. The relative form keeps requests same-origin so the
# httpOnly refresh cookie works; Vite proxies /api to API_PROXY_TARGET in dev.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api (the Go API)
API_PROXY_TARGET=http://localhost:8080

# Set to "true" to serve MSW mocks in the browser during dev
VITE_ENABLE_MSW=false
